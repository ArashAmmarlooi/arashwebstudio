# Get a free API key at https://resend.com (free plan: 100 emails/day)
# 1. Sign up with any email
# 2. Go to "API Keys" -> "Create API Key"
# 3. Copy the key here, then rename this file to .env.local
RESEND_API_KEY=

# Your final public URL, including https:// and no path.
# Production domain
NEXT_PUBLIC_SITE_URL=https://arashwebstudio.com

# Optional: paste the HTML-tag verification value from Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
