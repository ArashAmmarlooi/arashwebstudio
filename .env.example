# Get a free API key at https://resend.com (free plan: 100 emails/day)
# 1. Sign up with any email
# 2. Go to "API Keys" -> "Create API Key"
# 3. Copy the key here, then rename this file to .env.local
RESEND_API_KEY=

# Resend sender (verify arashwebstudio.com in Resend first).
# RESEND_FROM=Arash Web Studio <hello@arashwebstudio.com>

# Where contact form messages are delivered (real mailbox you check).
# CONTACT_INBOX=arashammarlooi@hotmail.com

# Default Reply-To for future customer-facing emails from @arashwebstudio.com
# (contact notifications Reply-To the visitor instead).
# RESEND_REPLY_TO=arashammarlooi@hotmail.com

# Local dev without a verified domain: use Resend's sandbox sender instead.
# RESEND_FROM=Arash Web Studio <onboarding@resend.dev>

# Your final public URL, including https:// and no path.
# Production domain
NEXT_PUBLIC_SITE_URL=https://www.arashwebstudio.com

# Optional: paste the HTML-tag verification value from Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
